<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_clock_area" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextClock android:id="@+id/widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:textSize="32sp" android:textStyle="bold"
                android:textColor="#3D3435" android:maxLines="1" />
            <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#8A6D68" android:maxLines="1" />
        </LinearLayout>
        <ImageView android:layout_width="46dp" android:layout_height="46dp" android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@string/app_name" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_weather_area" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/widget_weather" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#5B8B72" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_weather_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#8A7D7B" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_task" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="24dp" android:gravity="center_vertical" android:textColor="#3D3435" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_event" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="24dp" android:gravity="center_vertical" android:textColor="#C76057" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_notes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="@string/widget_notes" android:textColor="#8A6D68" android:textSize="12sp" android:gravity="center_vertical" />
        <TextView android:id="@+id/widget_timer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="@string/widget_timer" android:textColor="#C76057" android:textSize="12sp" android:gravity="end|center_vertical" />
    </LinearLayout>
</LinearLayout>
