<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/cat_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/cat_widget_blush">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:background="@drawable/cat_bubble" android:paddingLeft="10dp">
        <TextView android:id="@+id/cat_widget_name" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:text="@string/cat_default_name" android:textSize="15sp" android:textStyle="bold" android:textColor="#3D3435" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/cat_widget_level" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_default_level" android:textSize="12sp" android:textColor="#8B756E" />
        <ImageButton android:id="@+id/cat_widget_settings" android:layout_width="36dp" android:layout_height="32dp" android:padding="8dp"
            android:src="@drawable/cat_icon_settings" android:background="@android:color/transparent" android:contentDescription="@string/cat_settings" android:scaleType="fitCenter" />
    </LinearLayout>
    <TextView android:id="@+id/cat_widget_message" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp"
        android:paddingLeft="9dp" android:paddingRight="9dp" android:gravity="center" android:background="@drawable/cat_bubble"
        android:text="@string/cat_welcome" android:textSize="12sp" android:textColor="#80675E" android:maxLines="2" android:ellipsize="end" />
    <ImageView android:id="@+id/cat_widget_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="90dp" android:src="@drawable/cat_idle_pink" android:scaleType="fitCenter" android:contentDescription="@string/cat_pet" />
    <TextView android:id="@+id/cat_widget_stats" android:layout_width="match_parent" android:layout_height="23dp" android:gravity="center"
        android:background="@drawable/cat_bubble" android:text="@string/cat_default_stats" android:textColor="#80675E" android:textSize="11sp" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:background="@drawable/cat_bubble">
        <LinearLayout android:id="@+id/cat_widget_pet" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:contentDescription="@string/cat_pet">
            <ImageView android:layout_width="21dp" android:layout_height="21dp" android:src="@drawable/cat_icon_pet" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_pet" android:textSize="11sp" android:textColor="#64524C" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cat_widget_feed" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:contentDescription="@string/cat_feed">
            <ImageView android:layout_width="21dp" android:layout_height="21dp" android:src="@drawable/cat_icon_feed" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_feed" android:textSize="11sp" android:textColor="#64524C" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cat_widget_play" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:contentDescription="@string/cat_play">
            <ImageView android:layout_width="21dp" android:layout_height="21dp" android:src="@drawable/cat_icon_play" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_play" android:textSize="11sp" android:textColor="#64524C" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cat_widget_rest" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/cat_widget_rest_icon" android:layout_width="21dp" android:layout_height="21dp" android:src="@drawable/cat_icon_sleep" android:importantForAccessibility="no" />
            <TextView android:id="@+id/cat_widget_rest_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_sleep" android:textSize="11sp" android:textColor="#64524C" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/cat_widget_music" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="6dp" android:gravity="center_vertical" android:paddingLeft="10dp" android:paddingRight="4dp" android:background="@drawable/cat_bubble">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/cat_widget_music_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/system_music_title" android:textSize="12sp" android:textColor="#64524C" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/cat_widget_music_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/system_music_ready" android:textSize="11sp" android:textColor="#9C877D" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/cat_widget_music_toggle" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp"
            android:src="@drawable/bgm_icon_play" android:background="@android:color/transparent" android:scaleType="fitCenter" android:contentDescription="@string/system_music_play" />
        <ImageButton android:id="@+id/cat_widget_music_open" android:layout_width="44dp" android:layout_height="44dp" android:padding="12dp"
            android:src="@drawable/bgm_icon_music" android:background="@android:color/transparent" android:scaleType="fitCenter" android:contentDescription="@string/system_music_open" />
    </LinearLayout>
</LinearLayout>
